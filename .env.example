# 课堂后端服务地址，不要以 /api 结尾。
NEXT_PUBLIC_API_URL=http://localhost:8000

# IM HTTP 服务地址（与 WebSocket 可能不是同一域名）。浏览器经 /im-api 转发，避免跨域。
# NEXT_PUBLIC_IM_API_URL=https://im-api.example.com

# Web 客户端请求头信息。
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_BUILD=1
NEXT_PUBLIC_APP_CHANNEL=web

# 是否使用本地 Mock 数据。
USE_MOCK_DATA=false

# 腾讯云点播默认分发域名（不要带 https://）。录播会把 GetPlayInfo 返回的地址改写到该域名，与直播回放同类直链播放。
NEXT_PUBLIC_TENCENT_VOD_DOMAIN=

# 中测易聘门户地址与中台应用编码，用于导航跳转的票据登录同步。
NEXT_PUBLIC_ZCYP_PORTAL_URL=https://zcyp-web.jxhrm.com
NEXT_PUBLIC_ZCYP_APP_CODE=zcyp

# 日志最低级别：debug、info、warn、error、silent。
LOG_LEVEL=info
